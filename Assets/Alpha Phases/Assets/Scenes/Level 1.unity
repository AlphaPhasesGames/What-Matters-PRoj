    - target: {fileID: 283495610418290967, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: All the substances around us are made of matter, even the air we breathe!
        T
      objectReference: {fileID: 0}
    - target: {fileID: 512829998547794065, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
