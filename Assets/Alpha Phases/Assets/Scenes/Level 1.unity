      propertyPath: m_Name
      value: New Canvas
      objectReference: {fileID: 0}
    - target: {fileID: 2074889509050986068, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: Well done! A shadow forms when an object blocks light. A shadow is not
        matter because it has neither mass nor volume. t
      objectReference: {fileID: 0}
    - target: {fileID: 2074889509050986068, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
