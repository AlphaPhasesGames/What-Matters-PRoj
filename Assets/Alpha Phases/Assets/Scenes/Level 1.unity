      objectReference: {fileID: 0}
    - target: {fileID: 3564205943545871993, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: Good morning scientist. T
      objectReference: {fileID: 0}
