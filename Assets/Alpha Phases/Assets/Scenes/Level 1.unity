    - target: {fileID: 2216788984882221952, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: On this table is an object casting a shadow. Select the shadow to take
        a closer look or click the cross to leave the table. t
      objectReference: {fileID: 0}
    - target: {fileID: 2216788984882221952, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
