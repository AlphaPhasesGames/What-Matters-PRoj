      objectReference: {fileID: 0}
    - target: {fileID: 2986331126027814725, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: "Here we are in the lab! Let\u2019s investigate matter. T"
      objectReference: {fileID: 0}
    - target: {fileID: 3226869167794666347, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_text
      value: Let's move into the next room. You can move around with the WASD keys
        or the arrow keys. T
      objectReference: {fileID: 0}
    - target: {fileID: 3424252236706304315, guid: 34b3940e982d4fd4b8a073e83a19eed9, type: 3}
      propertyPath: m_IsActive
